# Allowed browser origins for cross-origin API usage (comma-separated).
ETF_ALLOWED_ORIGINS=https://your-domain.example

# Holdings source adapter:
# - etfinfo_public_page
# - official_endpoint
# - official_pcf_twse
# - official_snapshot_file
ETF_HOLDINGS_ADAPTER=etfinfo_public_page

# Network retry controls for live holdings refresh.
ETF_FETCH_TIMEOUT_SECONDS=20
ETF_FETCH_RETRIES=2
ETF_FETCH_BACKOFF_MS=600
# For official adapters, require complete holdings snapshots.
ETF_LIVE_REQUIRE_FULL_HOLDINGS=1
ETF_LIVE_MIN_DECLARED_HOLDINGS=30
ETF_LIVE_MIN_PARSED_HOLDINGS=30

# Direct official endpoint settings (for official_endpoint adapter).
# URL template supports {code} and {date}.
ETF_OFFICIAL_ENDPOINT_URL_TEMPLATE=
ETF_OFFICIAL_ENDPOINT_FORMAT=json
ETF_OFFICIAL_ENDPOINT_HOLDINGS_PATH=
ETF_OFFICIAL_ENDPOINT_ASOF_PATH=
ETF_OFFICIAL_ENDPOINT_DECLARED_COUNT_PATH=
ETF_OFFICIAL_ENDPOINT_CODE_FIELD=code
ETF_OFFICIAL_ENDPOINT_WEIGHT_FIELD=weight
ETF_OFFICIAL_ENDPOINT_NAME_FIELD=name
ETF_OFFICIAL_ENDPOINT_SHARES_FIELD=shares
ETF_OFFICIAL_ENDPOINT_PRICE_FIELD=price
ETF_OFFICIAL_ENDPOINT_DATE=
ETF_OFFICIAL_ENDPOINT_HEADERS=

# Direct official PCF endpoint profile (optional, used by official_pcf_twse).
ETF_OFFICIAL_PCF_URL_TEMPLATE=
ETF_OFFICIAL_PCF_FORMAT=csv
ETF_OFFICIAL_PCF_HOLDINGS_PATH=
ETF_OFFICIAL_PCF_ASOF_PATH=
ETF_OFFICIAL_PCF_DECLARED_COUNT_PATH=
ETF_OFFICIAL_PCF_CODE_FIELD=
ETF_OFFICIAL_PCF_WEIGHT_FIELD=
ETF_OFFICIAL_PCF_NAME_FIELD=
ETF_OFFICIAL_PCF_SHARES_FIELD=
ETF_OFFICIAL_PCF_PRICE_FIELD=
ETF_OFFICIAL_PCF_HEADERS=

# Direct official TWSE endpoint profile (optional, used by official_pcf_twse).
ETF_OFFICIAL_TWSE_URL_TEMPLATE=
ETF_OFFICIAL_TWSE_FORMAT=csv
ETF_OFFICIAL_TWSE_HOLDINGS_PATH=
ETF_OFFICIAL_TWSE_ASOF_PATH=
ETF_OFFICIAL_TWSE_DECLARED_COUNT_PATH=
ETF_OFFICIAL_TWSE_CODE_FIELD=
ETF_OFFICIAL_TWSE_WEIGHT_FIELD=
ETF_OFFICIAL_TWSE_NAME_FIELD=
ETF_OFFICIAL_TWSE_SHARES_FIELD=
ETF_OFFICIAL_TWSE_PRICE_FIELD=
ETF_OFFICIAL_TWSE_HEADERS=

# TWSE official ETF metadata/metrics import endpoints.
ETF_TWSE_RWD_BASE_URL=https://www.twse.com.tw
ETF_TWSE_RWD_LANG=zh
ETF_ETFFORTUNE_PRODUCTS_ENDPOINT=/zh/ETFortune/ajaxProductsResult
ETF_ETFFORTUNE_CHART_ENDPOINT=/zh/ETFortune-institute/ajaxEtfInfoChart

# Local directory for official snapshot files (one file per ETF code, e.g. 00400A.json).
ETF_OFFICIAL_SNAPSHOT_DIR=data/official-snapshots

# Per-code/per-issuer official source registry.
# Use ETF_HOLDINGS_ADAPTER=official_registry or ETF_HOLDINGS_ADAPTER=official.
ETF_OFFICIAL_SOURCE_REGISTRY_FILE=data/official-source-registry.json

# History retention policy:
# - keep snapshots within this rolling day window (0 = no age-based pruning)
ETF_HISTORY_RETENTION_DAYS=730
# - keep at most N snapshots per ETF code (0 = no per-code cap)
ETF_HISTORY_MAX_SNAPSHOTS_PER_CODE=0
# - when real official snapshots exist, drop seed snapshots for that ETF
ETF_HISTORY_DROP_SEED_WHEN_REAL=1
ETF_HISTORY_QUALITY_REPORT_FILE=data/history-quality-latest.json

# Multi-user data ownership for portfolio/watchlist:
# - default user scope used when header/query user context is missing
ETF_DEFAULT_USER_ID=public
# - when enabled, portfolio/watchlist/status/history-quality APIs require explicit user context
#   either query parameter `user=...` or request header `X-ETF-User`
ETF_REQUIRE_USER_CONTEXT=0

# API hardening:
# ETF_API_AUTH_MODE:
# - off (default)
# - write_token (require token for POST/PUT/DELETE)
# - all_token (require token for all methods)
ETF_API_AUTH_MODE=off
ETF_API_TOKEN=

# Simple in-memory rate limit (per process):
ETF_RATE_LIMIT_ENABLED=0
ETF_RATE_LIMIT_WINDOW_SECONDS=60
ETF_RATE_LIMIT_MAX_REQUESTS=120
ETF_RATE_LIMIT_KEY_MODE=ip

# Structured access log rotation.
ETF_ACCESS_LOG_ENABLED=1
ETF_ACCESS_LOG_FILE=data/access-log.jsonl
ETF_ACCESS_LOG_MAX_BYTES=5242880
ETF_ACCESS_LOG_BACKUP_COUNT=5

# Optional webhook for alert notifications.
ETF_ALERT_WEBHOOK_URL=
ETF_ALERT_WEBHOOK_TIMEOUT_SECONDS=3
